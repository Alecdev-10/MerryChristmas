# Copie ce fichier en .env.local (et ajoute les mêmes variables dans Vercel > Settings > Environment Variables)

# Ton identifiant Amazon Partenaires (ex. tonnom-21). Ajouté automatiquement à chaque lien Amazon.
NEXT_PUBLIC_AMAZON_TAG=votreid-21

# Adresse publique du site, sans / final (sert au sitemap et aux aperçus Pinterest)
NEXT_PUBLIC_SITE_URL=https://merrychristmas.vercel.app

# (Optionnel) Code de vérification du domaine Pinterest : Paramètres Pinterest > Comptes revendiqués > Site web > balise meta, valeur de content="..."
NEXT_PUBLIC_PINTEREST_VERIFY=
